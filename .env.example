# Copy to .env and adjust. Never commit .env.

# --- Application ---
TRACEIQ_ENV=development
TRACEIQ_LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call the API.
TRACEIQ_CORS_ORIGINS=http://localhost:5173

# --- Database ---
# Single source of credentials for the PostgreSQL container, the API container, and the
# backend run on the host. The backend builds its connection URL from these parts with
# SQLAlchemy's URL.create, so any characters are allowed (no URL-encoding).
# Keep the password in single quotes so Docker Compose and dotenv read it literally
# (otherwise "$" is treated as variable interpolation and " #" as a comment).
POSTGRES_USER=traceiq
POSTGRES_PASSWORD='change-me'
POSTGRES_DB=traceiq
# Host port for PostgreSQL (5433 avoids clashing with a locally installed PostgreSQL).
# On the host the backend connects to localhost:POSTGRES_PORT; in Compose it uses db:5432.
POSTGRES_PORT=5433

# Optional: a complete URL overrides the parts above. It must already be URL-encoded.
# TRACEIQ_DATABASE_URL=postgresql+psycopg://user:encoded-password@host:5432/dbname

# --- Background jobs and worker ---
# A claimed job must finish within its lease (handlers may set their own) or it is recovered.
TRACEIQ_JOB_DEFAULT_LEASE_SECONDS=300
# Total attempts per job, including the first.
TRACEIQ_JOB_DEFAULT_MAX_ATTEMPTS=5
# Retry delay: min(base * 2^(attempt-1), max), randomly scaled to 50-100%.
TRACEIQ_JOB_BACKOFF_BASE_SECONDS=10
TRACEIQ_JOB_BACKOFF_MAX_SECONDS=3600
# How long an idle worker waits before checking for jobs again.
TRACEIQ_WORKER_POLL_INTERVAL_SECONDS=1
# How often each worker recovers stale jobs and runs due schedules.
TRACEIQ_WORKER_MAINTENANCE_INTERVAL_SECONDS=15

# --- Authentication (API only) ---
# Required: the API refuses to start unless both are set, at least 32 bytes, not placeholders,
# and different from each other. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit real values. Changing a secret signs everyone out (tokens stop verifying).
TRACEIQ_JWT_SECRET=
TRACEIQ_CSRF_SECRET=
# Cookies. Secure must stay true in production (the API refuses to start otherwise). Browsers
# such as Chrome and Firefox accept Secure cookies on http://localhost; if yours does not, set
# false for local HTTP development only.
TRACEIQ_AUTH_COOKIE_SECURE=true
# lax (default), strict, or none (none requires Secure and a cross-site deployment review).
TRACEIQ_AUTH_COOKIE_SAMESITE=lax
# Leave empty for host-only cookies (recommended).
TRACEIQ_AUTH_COOKIE_DOMAIN=
# Empty: registration enabled in development, disabled in production. true/false overrides.
TRACEIQ_AUTH_REGISTRATION_ENABLED=
# Token lifetimes (seconds): access 15 min; each refresh token 7 days (rolling, renewed on every
# refresh); a session (refresh-token family) ends 30 days after login regardless of refreshes.
TRACEIQ_ACCESS_TOKEN_TTL_SECONDS=900
TRACEIQ_REFRESH_TOKEN_TTL_SECONDS=604800
TRACEIQ_REFRESH_TOKEN_ABSOLUTE_TTL_SECONDS=2592000
# Password hashing load: concurrent Argon2id operations per API process (1-64, 64 MiB each), and
# how long a login waits for capacity before answering 503 (seconds, up to 120).
TRACEIQ_AUTH_MAX_CONCURRENT_HASHES=4
TRACEIQ_AUTH_HASH_WAIT_TIMEOUT_SECONDS=10

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Host ports (optional) ---
# If you change these, update TRACEIQ_CORS_ORIGINS and VITE_API_BASE_URL to match.
# API_PORT=8000
# FRONTEND_PORT=5173
