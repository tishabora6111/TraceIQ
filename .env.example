# Copy to .env and adjust. Never commit .env.

# --- Application ---
TRACEIQ_ENV=development
TRACEIQ_LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call the API.
TRACEIQ_CORS_ORIGINS=http://localhost:5173

# --- Database ---
# Single source of credentials for the PostgreSQL container, the API container, and the
# backend run on the host. The backend builds its connection URL from these parts with
# SQLAlchemy's URL.create, so any characters are allowed (no URL-encoding).
# Keep the password in single quotes so Docker Compose and dotenv read it literally
# (otherwise "$" is treated as variable interpolation and " #" as a comment).
POSTGRES_USER=traceiq
POSTGRES_PASSWORD='change-me'
POSTGRES_DB=traceiq
# Host port for PostgreSQL (5433 avoids clashing with a locally installed PostgreSQL).
# On the host the backend connects to localhost:POSTGRES_PORT; in Compose it uses db:5432.
POSTGRES_PORT=5433

# Optional: a complete URL overrides the parts above. It must already be URL-encoded.
# TRACEIQ_DATABASE_URL=postgresql+psycopg://user:encoded-password@host:5432/dbname

# --- Background jobs and worker ---
# A claimed job must finish within its lease (handlers may set their own) or it is recovered.
TRACEIQ_JOB_DEFAULT_LEASE_SECONDS=300
# Total attempts per job, including the first.
TRACEIQ_JOB_DEFAULT_MAX_ATTEMPTS=5
# Retry delay: min(base * 2^(attempt-1), max), randomly scaled to 50-100%.
TRACEIQ_JOB_BACKOFF_BASE_SECONDS=10
TRACEIQ_JOB_BACKOFF_MAX_SECONDS=3600
# How long an idle worker waits before checking for jobs again.
TRACEIQ_WORKER_POLL_INTERVAL_SECONDS=1
# How often each worker recovers stale jobs and runs due schedules.
TRACEIQ_WORKER_MAINTENANCE_INTERVAL_SECONDS=15

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Host ports (optional) ---
# If you change these, update TRACEIQ_CORS_ORIGINS and VITE_API_BASE_URL to match.
# API_PORT=8000
# FRONTEND_PORT=5173
